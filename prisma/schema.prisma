generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth Models ─────────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  watchlistItems WatchlistItem[]
  watchedItems   WatchedItem[]
  ratings        UserRating[]
  reviews        UserReview[]
  preferences    UserPreference?

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ─── Content Models ──────────────────────────────────────────

model Movie {
  id            String   @id @default(cuid())
  tmdbId        Int      @unique
  title         String
  originalTitle String?
  overview      String?  @db.Text
  posterPath    String?
  backdropPath  String?
  releaseDate   String?
  runtime       Int?
  voteAverage   Float?
  voteCount     Int?
  popularity    Float?
  genres        String?  // JSON string of genre objects
  tagline       String?
  status        String?
  budget        Int?
  revenue       Int?
  imdbId        String?
  collectionId  Int?     // TMDB collection ID for franchise detection
  collectionName String?
  credits       String?  @db.Text // JSON string of cast/crew
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  watchlistItems WatchlistItem[]
  watchedItems   WatchedItem[]
  ratings        UserRating[]
  reviews        UserReview[]
  franchiseEntries FranchiseEntry[]

  @@map("movies")
}

model TVShow {
  id              String   @id @default(cuid())
  tmdbId          Int      @unique
  name            String
  originalName    String?
  overview        String?  @db.Text
  posterPath      String?
  backdropPath    String?
  firstAirDate    String?
  lastAirDate     String?
  numberOfSeasons Int?
  numberOfEpisodes Int?
  voteAverage     Float?
  voteCount       Int?
  popularity      Float?
  genres          String?  // JSON string
  tagline         String?
  status          String?
  episodeRunTime  String?  // JSON string
  credits         String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seasons        Season[]
  watchlistItems WatchlistItem[]
  watchedItems   WatchedItem[]
  ratings        UserRating[]
  reviews        UserReview[]

  @@map("tv_shows")
}

model Season {
  id           String  @id @default(cuid())
  tmdbId       Int
  tvShowId     String
  seasonNumber Int
  name         String?
  overview     String? @db.Text
  posterPath   String?
  airDate      String?
  episodeCount Int?
  createdAt    DateTime @default(now())

  tvShow   TVShow    @relation(fields: [tvShowId], references: [id], onDelete: Cascade)
  episodes Episode[]
  watchlistItems WatchlistItem[]
  watchedItems   WatchedItem[]

  @@unique([tvShowId, seasonNumber])
  @@map("seasons")
}

model Episode {
  id            String  @id @default(cuid())
  tmdbId        Int
  seasonId      String
  episodeNumber Int
  name          String?
  overview      String? @db.Text
  stillPath     String?
  airDate       String?
  runtime       Int?
  voteAverage   Float?
  createdAt     DateTime @default(now())

  season Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  watchedItems WatchedItem[]

  @@unique([seasonId, episodeNumber])
  @@map("episodes")
}

// ─── Franchise / Collection Models ───────────────────────────

model Franchise {
  id          String   @id @default(cuid())
  tmdbCollectionId Int?
  name        String
  overview    String?  @db.Text
  posterPath  String?
  backdropPath String?
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries FranchiseEntry[]

  @@unique([userId, tmdbCollectionId])
  @@map("franchises")
}

model FranchiseEntry {
  id              String   @id @default(cuid())
  franchiseId     String
  movieId         String?
  contentType     String   @default("movie") // movie | tvshow
  tmdbId          Int
  title           String
  sequenceNumber  Int      // Official order in the franchise
  releaseDate     String?
  posterPath      String?
  watched         Boolean  @default(false)
  watchedDate     DateTime?
  userId          String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  franchise Franchise @relation(fields: [franchiseId], references: [id], onDelete: Cascade)
  movie     Movie?    @relation(fields: [movieId], references: [id])

  @@unique([franchiseId, sequenceNumber])
  @@unique([franchiseId, tmdbId])
  @@map("franchise_entries")
}

// ─── User Content Models ─────────────────────────────────────

model WatchlistItem {
  id          String   @id @default(cuid())
  userId      String
  contentType String   // movie | tvshow | season
  movieId     String?
  tvShowId    String?
  seasonId    String?
  tmdbId      Int
  title       String
  posterPath  String?
  overview    String?  @db.Text
  releaseDate String?
  voteAverage Float?
  genres      String?
  priority    Int      @default(0)
  notes       String?  @db.Text
  addedAt     DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id])
  tvShow TVShow? @relation(fields: [tvShowId], references: [id])
  season Season? @relation(fields: [seasonId], references: [id])

  @@unique([userId, contentType, tmdbId])
  @@map("watchlist_items")
}

model WatchedItem {
  id              String   @id @default(cuid())
  userId          String
  contentType     String   // movie | tvshow | season | episode
  movieId         String?
  tvShowId        String?
  seasonId        String?
  episodeId       String?
  tmdbId          Int
  title           String
  posterPath      String?
  releaseDate     String?
  voteAverage     Float?
  genres          String?
  watchedDate     DateTime @default(now())
  chronoPosition  Int      // Position in overall watched history
  franchiseId     String?  // Link to franchise if part of one
  franchiseSeq    Int?     // Position within franchise sequence
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie   Movie?   @relation(fields: [movieId], references: [id])
  tvShow  TVShow?  @relation(fields: [tvShowId], references: [id])
  season  Season?  @relation(fields: [seasonId], references: [id])
  episode Episode? @relation(fields: [episodeId], references: [id])

  @@unique([userId, contentType, tmdbId])
  @@map("watched_items")
}

model UserRating {
  id          String   @id @default(cuid())
  userId      String
  contentType String
  movieId     String?
  tvShowId    String?
  tmdbId      Int
  rating      Float    // 1-10
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id])
  tvShow TVShow? @relation(fields: [tvShowId], references: [id])

  @@unique([userId, contentType, tmdbId])
  @@map("user_ratings")
}

model UserReview {
  id          String   @id @default(cuid())
  userId      String
  contentType String
  movieId     String?
  tvShowId    String?
  tmdbId      Int
  review      String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie  Movie?  @relation(fields: [movieId], references: [id])
  tvShow TVShow? @relation(fields: [tvShowId], references: [id])

  @@unique([userId, contentType, tmdbId])
  @@map("user_reviews")
}

model UserPreference {
  id                String   @id @default(cuid())
  userId            String   @unique
  theme             String   @default("dark")
  favoriteGenres    String?  // JSON string
  defaultContentType String  @default("all") // all | movie | tvshow
  enableNotifications Boolean @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}
